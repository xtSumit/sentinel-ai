# Sentinel AI Environment Configuration Template

# APP_MODE: Operating mode ('preview' or 'production'). Defaults to preview.
APP_MODE="preview"

# Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT="sentinel-ai-511412"
GOOGLE_CLOUD_LOCATION="us-central1"

# Gemini & Vertex AI Configuration
# When GOOGLE_GENAI_USE_VERTEXAI is true, the Gemini SDK uses Vertex AI with the runtime service account (no API key required)
GOOGLE_GENAI_USE_VERTEXAI="true"
# GEMINI_API_KEY: Fallback API key used when GOOGLE_GENAI_USE_VERTEXAI is false/unset
GEMINI_API_KEY=""

# Google Cloud Pub/Sub Configuration (Production)
PUBSUB_TOPIC="projects/sentinel-ai-511412/topics/corporate-registry-events"
PUBSUB_PUSH_SA="sentinel-pubsub-invoker@sentinel-ai-511412.iam.gserviceaccount.com"
PUBSUB_PUSH_AUDIENCE="https://ais-dev-fex73v2mw3mpbcdlf65r7j-186134377428.asia-east1.run.app/api/events/registry"

# Google BigQuery Sanctions Table (Production)
BQ_SANCTIONS_TABLE="sentinel-ai-511412.compliance_screening.opensanctions_entities"

# Google Cloud Document AI & Cloud Storage (Production)
DOCAI_LOCATION="us"
DOCAI_PROCESSOR_ID="form-parser-processor-id"
EVIDENCE_BUCKET="sentinel-compliance-evidence-vault"

# Cloud Run App URL (automatically provided in Cloud Run)
APP_URL="https://ais-dev-fex73v2mw3mpbcdlf65r7j-186134377428.asia-east1.run.app"


