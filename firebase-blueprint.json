{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and governance mode preference",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["analyst", "supervisor"] },
        "governanceMode": { "type": "string", "enum": ["human-in-the-loop", "automated"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "role"]
    },
    "AuditRecord": {
      "title": "AuditRecord",
      "description": "Immutable append-only audit trail record for compliance actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorType": { "type": "string", "enum": ["HUMAN", "SYSTEM", "AI"] },
        "actorName": { "type": "string" },
        "action": { "type": "string" },
        "summary": { "type": "string" },
        "timestamp": { "type": "string" },
        "customerId": { "type": "string" },
        "groupId": { "type": "string" },
        "eventId": { "type": "string" },
        "caseId": { "type": "string" },
        "personId": { "type": "string" },
        "isAiGenerated": { "type": "boolean" },
        "details": { "type": "object" }
      },
      "required": ["actorUid", "actorType", "action", "timestamp"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Onboarded entity under perpetual KYC monitoring",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "legalName": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "groupKey": { "type": "string" },
        "onboardedBy": { "type": "string" },
        "onboardedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["onboarded", "offboarded", "under_review"] }
      },
      "required": ["customerId", "legalName", "jurisdiction", "groupKey", "onboardedBy", "status"]
    },
    "Event": {
      "title": "Event",
      "description": "Registry change event for ownership graph mutation and materiality assessment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "groupId": { "type": "string" },
        "templateId": { "type": "string" },
        "changeType": { "type": "string", "enum": ["SHARE_CHANGE", "NEW_RELATIONSHIP", "RELATIONSHIP_ENDED", "ENTITY_DISSOLVED"] },
        "payload": { "type": "object" },
        "description": { "type": "string" },
        "source": { "type": "string" },
        "confidence": { "type": "number" },
        "detectedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "monitoring", "dismissed"] },
        "decidedBy": { "type": "string" },
        "decidedAt": { "type": "string" },
        "dismissReason": { "type": "string" }
      },
      "required": ["customerId", "groupId", "changeType", "status"]
    },
    "ScreeningRun": {
      "title": "ScreeningRun",
      "description": "Full telemetry and findings for an asynchronous due diligence screening execution",
      "type": "object",
      "properties": {
        "runId": { "type": "string" },
        "customerId": { "type": "string" },
        "groupId": { "type": "string" },
        "triggerType": { "type": "string", "enum": ["PKYC", "ONBOARDING"] },
        "startedAt": { "type": "string" },
        "startedBy": { "type": "string" },
        "completedAt": { "type": "string" },
        "overallOutcome": { "type": "string", "enum": ["HIT", "REVIEW", "CLEAR"] }
      },
      "required": ["runId", "customerId", "groupId", "triggerType", "startedAt", "startedBy", "overallOutcome"]
    },
    "Case": {
      "title": "Case",
      "description": "Compliance case docket record for PKYC and onboarding due diligence",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caseId": { "type": "string" },
        "type": { "type": "string", "enum": ["PKYC", "ONBOARDING"] },
        "customerId": { "type": "string" },
        "groupId": { "type": "string" },
        "groupName": { "type": "string" },
        "overallStatus": { "type": "string", "enum": ["CRITICAL", "STANDARD", "CLEAR"] },
        "state": { "type": "string", "enum": ["open", "closed"] },
        "analystUid": { "type": "string" },
        "createdAt": { "type": "string" },
        "closedBy": { "type": "string" },
        "closedAt": { "type": "string" },
        "resolutionNote": { "type": "string" }
      },
      "required": ["id", "caseId", "type", "customerId", "groupId", "overallStatus", "state", "analystUid", "createdAt"]
    },
    "DocumentExtraction": {
      "title": "DocumentExtraction",
      "description": "Document intake, extraction record, and analyst confirmation ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "groupId": { "type": "string" },
        "gapId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileMimeType": { "type": "string" },
        "extractor": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "extracted", "confirmed", "rejected"] },
        "analystUid": { "type": "string" },
        "requestedAt": { "type": "string" },
        "extractedAt": { "type": "string" },
        "confirmedAt": { "type": "string" }
      },
      "required": ["id", "customerId", "groupId", "gapId", "fileName", "status", "analystUid"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Private user profiles with role and governance preferences"
    },
    "/audit/{auditId}": {
      "schema": "AuditRecord",
      "description": "Append-only immutable audit trail"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Onboarded KYC customers"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Ownership registry changes and monitoring alert feed"
    },
    "/screeningRuns/{runId}": {
      "schema": "ScreeningRun",
      "description": "Screening execution runs and findings"
    },
    "/cases/{caseId}": {
      "schema": "Case",
      "description": "Compliance case docket for PKYC and onboarding"
    },
    "/documentExtractions/{extractionId}": {
      "schema": "DocumentExtraction",
      "description": "Document intake and shareholder extractions"
    }
  }
}
