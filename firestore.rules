rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSupervisor() {
      return isSignedIn() && getUserRole() == 'supervisor';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users collection: users/{uid}
    // Readable by owner only.
    // Create: owner only, with role "analyst".
    // Update: owner only; can only update governanceMode (and only to "automated" if supervisor), role can NEVER be changed by client.
    // Delete: denied.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['uid', 'role'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'analyst'
        && (!('governanceMode' in request.resource.data) || request.resource.data.governanceMode == 'human-in-the-loop');

      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['governanceMode'])
          || request.resource.data.governanceMode == 'human-in-the-loop'
          || (request.resource.data.governanceMode == 'automated' && resource.data.role == 'supervisor')
        );

      allow delete: if false;
    }

    // 2. Audit collection: audit/{auditId}
    // Any signed-in user can read and create.
    // Create requires actorUid == request.auth.uid, actorType in ['HUMAN', 'SYSTEM', 'AI'], action string, server timestamp.
    // Timestamp must strictly equal request.time (written via serverTimestamp()).
    // Append-only: no update, no delete.
    match /audit/{auditId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(auditId)
        && request.resource.data.keys().hasAll(['actorUid', 'actorType', 'action', 'timestamp'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorType in ['HUMAN', 'SYSTEM', 'AI']
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 500
        && request.resource.data.timestamp == request.time;

      allow update: if false;
      allow delete: if false;
    }

    // 3. Customers collection: customers/{customerId}
    // Any signed-in user can read.
    // Create requires onboardedBy == request.auth.uid, status == "onboarded", valid fields.
    // Update: only status may be updated.
    // Delete: denied.
    match /customers/{customerId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(customerId)
        && request.resource.data.keys().hasAll(['customerId', 'legalName', 'jurisdiction', 'groupKey', 'onboardedBy', 'status'])
        && request.resource.data.customerId == customerId
        && request.resource.data.onboardedBy == request.auth.uid
        && request.resource.data.status == 'onboarded'
        && request.resource.data.legalName is string
        && request.resource.data.legalName.size() > 0
        && request.resource.data.legalName.size() <= 200
        && request.resource.data.jurisdiction is string
        && request.resource.data.groupKey is string;

      allow update: if isSignedIn()
        && isValidId(customerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['onboarded', 'offboarded', 'under_review'];

      allow delete: if false;
    }

    // 4. Events collection: events/{eventId}
    // Readable by signed-in users.
    // Create: supervisors only (for preview injection; prod push endpoint writes server-side via Admin SDK).
    // New events must always be created with status "pending", and with decidedBy, decidedAt and dismissReason absent.
    // Update: any signed-in user may update only status, decidedBy, decidedAt, dismissReason, only from pending,
    // decidedBy must equal request.auth.uid, and decidedAt must equal request.time.
    // If status is dismissed, dismissReason is mandatory.
    // Delete: denied.
    // 4. Events collection: events/{eventId}
    // Readable by signed-in users.
    // Create: supervisors only (for preview injection; prod push endpoint writes server-side via Admin SDK).
    // New events must always be created with status "pending", and with decidedBy, decidedAt and dismissReason absent.
    // Update: any signed-in user may update only status, decidedBy, decidedByName, decidedAt, dismissReason, only from pending,
    // decidedBy must equal request.auth.uid, and decidedAt must equal request.time.
    // If status is dismissed, dismissReason is mandatory.
    // Delete: denied.
    match /events/{eventId} {
      allow read: if isSignedIn();

      allow create: if isSupervisor()
        && isValidId(eventId)
        && request.resource.data.keys().hasAll(['customerId', 'groupId', 'changeType', 'status'])
        && (request.resource.data.status == 'pending' || request.resource.data.status == 'PENDING')
        && !('decidedBy' in request.resource.data)
        && !('decidedByName' in request.resource.data)
        && !('decidedAt' in request.resource.data)
        && !('dismissReason' in request.resource.data)
        && request.resource.data.changeType in ['SHARE_CHANGE', 'NEW_RELATIONSHIP', 'RELATIONSHIP_ENDED', 'ENTITY_DISSOLVED'];

      allow update: if isSignedIn()
        && isValidId(eventId)
        && (resource.data.status == 'pending' || resource.data.status == 'PENDING')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedByName', 'decidedAt', 'dismissReason'])
        && request.resource.data.status in ['accepted', 'monitoring', 'dismissed']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && (!('decidedByName' in request.resource.data) || (request.resource.data.decidedByName is string && request.resource.data.decidedByName.size() <= 120))
        && (
          request.resource.data.status != 'dismissed'
          || (
            'dismissReason' in request.resource.data
            && request.resource.data.dismissReason is string
            && request.resource.data.dismissReason.size() > 0
          )
        );

      allow delete: if false;
    }

    // 5. Screening Runs collection: screeningRuns/{runId}
    // Readable by signed-in users.
    // Created and updated only by user who started it.
    // Delete: denied.
    match /screeningRuns/{runId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(runId)
        && request.resource.data.startedBy == request.auth.uid
        && request.resource.data.keys().hasAll(['runId', 'customerId', 'groupId', 'triggerType', 'startedBy', 'startedAt']);

      allow update: if isSignedIn()
        && resource.data.startedBy == request.auth.uid
        && request.resource.data.startedBy == resource.data.startedBy;

      allow delete: if false;
    }

    // 6. Cases collection: cases/{caseId}
    // Readable by signed-in users.
    // Created by the analyst who ran screening.
    // Updates limited to state, resolutionNote, closedBy, closedByName, closedAt, only from open to closed.
    // Four-eyes rule: a CRITICAL case can only be closed by a supervisor, and never by the same person who created it.
    // Delete: denied.
    match /cases/{caseId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(caseId)
        && request.resource.data.analystUid == request.auth.uid
        && request.resource.data.keys().hasAll(['id', 'caseId', 'type', 'customerId', 'groupId', 'overallStatus', 'state', 'analystUid', 'createdAt'])
        && request.resource.data.state == 'open'
        && request.resource.data.type in ['PKYC', 'ONBOARDING']
        && request.resource.data.overallStatus in ['CRITICAL', 'STANDARD', 'CLEAR'];

      allow update: if isSignedIn()
        && isValidId(caseId)
        && (
          // Normal case closure (Four-eyes rule)
          (
            resource.data.state == 'open'
            && request.resource.data.state == 'closed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'resolutionNote', 'closedBy', 'closedByName', 'closedAt'])
            && request.resource.data.closedBy == request.auth.uid
            && request.resource.data.closedAt == request.time
            && (!('closedByName' in request.resource.data) || (request.resource.data.closedByName is string && request.resource.data.closedByName.size() <= 120))
            && request.resource.data.resolutionNote is string
            && request.resource.data.resolutionNote.size() >= 5
            && (
              resource.data.overallStatus != 'CRITICAL'
              || (
                isSupervisor()
                && request.auth.uid != resource.data.analystUid
              )
            )
          )
          ||
          // Case Archiving per Requirement 4.3 (Supervisor-only)
          (
            isSupervisor()
            && (!('archived' in resource.data) || resource.data.archived != true)
            && request.resource.data.archived == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'archivedBy', 'archivedByName', 'archivedAt', 'archiveReason'])
            && request.resource.data.archivedBy == request.auth.uid
            && request.resource.data.archivedAt == request.time
            && (!('archivedByName' in request.resource.data) || (request.resource.data.archivedByName is string && request.resource.data.archivedByName.size() <= 120))
            && request.resource.data.archiveReason is string
            && request.resource.data.archiveReason.size() >= 5
          )
          ||
          // Case Restoring (Supervisor-only)
          (
            isSupervisor()
            && resource.data.archived == true
            && request.resource.data.archived == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'restoredBy', 'restoredByName', 'restoredAt', 'restoreReason'])
            && request.resource.data.restoredBy == request.auth.uid
            && request.resource.data.restoredAt == request.time
            && (!('restoredByName' in request.resource.data) || (request.resource.data.restoredByName is string && request.resource.data.restoredByName.size() <= 120))
            && request.resource.data.restoreReason is string
            && request.resource.data.restoreReason.size() >= 5
          )
        );

      allow delete: if false;
    }

    // 7. Document Extractions collection: documentExtractions/{extractionId}
    // Readable by signed-in users.
    // Created and updated only by the requesting user.
    // Delete: denied.
    match /documentExtractions/{extractionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(extractionId)
        && request.resource.data.analystUid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.analystUid == request.auth.uid
        && request.resource.data.analystUid == resource.data.analystUid;

      allow delete: if false;
    }
  }
}
